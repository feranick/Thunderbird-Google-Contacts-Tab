{
  "manifest_version": 2,
  "name": "Google Contacts Tab",
  "description": "__MSG_extensionDescription__",
  "version": "0.5",
  "author": "Nicola Ferralis",
  "homepage_url": "https://github.com/feranick/Thunderbird-Google-Contacts-Tab/",
  "browser_specific_settings": {
    "gecko": {
      "id": "feranick.google-contacts-tab@addons.thunderbird.net",
      "strict_min_version": "106.0"
    }
  },  
  "permissions": [
    "messagesRead",
    "webRequest",
    "webRequestBlocking",
    "https://*.google.com/*",
    "menus"
  ],
  "default_locale": "en",
  "icons": {
    "32": "skin/google_contacts_icon.svg",
    "48": "skin/google_contacts_icon.svg",
    "96": "skin/google_contacts_icon.svg"
  },
  "message_display_action": {
  "default_title": "Google Contacts",
  "default_icon": "skin/google_contacts_icon.svg"
  },
  "background": {
    "scripts": [
      "redirect.js"
    ]
  }
}
